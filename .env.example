# Shu faylni ".env" nomi bilan nusxalang va qiymatlarni to'ldiring.

# @BotFather bergan token
BOT_TOKEN=

# Adminlarning Telegram ID'lari, vergul bilan (masalan: 111111111,222222222)
ADMIN_IDS=

# Baza fayli
DB_PATH=data/bot.db

# Vaqt mintaqasi (eslatmalar uchun)
TIMEZONE=Asia/Tashkent

# Sayt (zakaz va qarzdorlar) uchun kirish PIN-kodi. Bo'sh bo'lsa sayt yopiq.
SITE_PIN=

# Kompyuterda saytni sinash uchun port (Railway o'zi PORT beradi)
# WEB_PORT=8080
